<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp 
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" 
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
  xsi:type="TaskPaneApp">
  <Id>d2b512a8-8e6d-49d7-8971-550fa49323c9</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>FinMesh Platform</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="FinMesh Financial Copilot" />
  <Description DefaultValue="Two-way live spreadsheet synchronization and zero-hallucination semantic metric formulas for Excel 365." />
  <IconUrl DefaultValue="https://localhost:3000/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/assets/icon-64.png" />
  <SupportUrl DefaultValue="https://finmesh.io/support" />
  <AppDomains>
    <AppDomain>http://localhost:3000</AppDomain>
    <AppDomain>http://localhost:8080</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook" />
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="http://localhost:3000/excel/taskpane" />
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
